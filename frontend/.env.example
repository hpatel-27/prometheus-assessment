# Frontend environment configuration.
# Copy to `.env` (or `.env.local`) and adjust for local development.
# Only variables prefixed with VITE_ are exposed to the client by Vite.
#
# NOTE: VITE_ vars are inlined into the bundle at BUILD time and are public.
# In production (Docker), this is passed as a build arg, not a runtime env var —
# a rebuild is required to change it. Never put secrets in a VITE_ variable.

# Origin of the backend API. The frontend calls only this backend, never
# Yahoo Finance directly. No trailing slash required.
VITE_API_BASE_URL=http://localhost:3000

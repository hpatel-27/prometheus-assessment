# Docker Compose configuration. Copy to `.env`, then `docker compose up --build`.
# These variables are consumed by docker-compose.yml (not read by the app
# directly — the app reads its own env vars, which Compose sets per service).

# --- Host ports ---
# Host port mapped to the backend container's port 3000.
BACKEND_PORT=3000
# Host port mapped to the frontend (nginx) container's port 80.
FRONTEND_PORT=8080

# --- Frontend (build-time) ---
# Origin the browser uses to reach the backend API. Inlined into the static
# bundle when the frontend image is built, so it must match how the backend is
# publicly reachable (host + BACKEND_PORT for local Compose). No trailing slash.
VITE_API_BASE_URL=http://localhost:3000

# --- Backend (runtime) ---
# Comma-separated browser origins allowed by CORS. Must include the origin the
# SPA is served from (host + FRONTEND_PORT).
CORS_ORIGINS=http://localhost:8080

# Express trust proxy. Leave `false` for this Compose topology (the browser
# reaches the backend directly). Set to the exact number of proxy hops ONLY when
# a trusted reverse proxy / load balancer terminates in front of the backend.
# Never `true` — that lets clients spoof their IP and evade rate limiting.
TRUST_PROXY=false

# Rate limiting, per client IP: window length (ms) and max requests per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
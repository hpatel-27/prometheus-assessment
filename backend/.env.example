# Backend environment configuration.
# Copy to `.env` and adjust for local development. Never commit the real `.env`.
# In Docker, these are supplied by docker-compose.yml instead of a .env file.

# Node runtime mode: development | test | production
NODE_ENV=development

# Port the API server listens on.
PORT=3000

# Comma-separated list of origins allowed by CORS (e.g. the frontend dev server).
CORS_ORIGINS=http://localhost:5173

# Express `trust proxy`. `false` keys the rate limiter on the direct socket IP.
# Behind a trusted reverse proxy, set to the exact number of proxy hops (e.g. 1)
# or a subnet allowlist so the real client IP is used. Never set to `true`.
TRUST_PROXY=false

# Rate limiting: window duration in milliseconds and maximum requests per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
